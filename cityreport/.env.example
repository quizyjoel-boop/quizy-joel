# --- Flask ---
SECRET_KEY=change-this-to-a-random-string

# --- Database ---
# Default: SQLite, zero setup — a cityreport.db file is created automatically.
# To use MySQL (e.g. via XAMPP) instead, uncomment the line below and point
# it at your database (create the schema first via phpMyAdmin or
# `CREATE DATABASE cityreport;`):
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/cityreport

# --- Mistral AI agent ---
# Get a key at https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409

# --- Default map center (Douala, Cameroon) ---
DEFAULT_LAT=4.0511
DEFAULT_LNG=9.7679

# --- First staff account (created via `flask create-admin`) ---
ADMIN_EMAIL=admin@cityreport.local
ADMIN_PASSWORD=changeme123
